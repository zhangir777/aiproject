# Groq API (https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# SQLite database path
DATABASE_URL=./data/enbek.db

# CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app

# Debug mode
DEBUG=false

# Optional: data.egov.kz API key (https://data.egov.kz)
# EGOV_API_KEY=your_egov_key_here
